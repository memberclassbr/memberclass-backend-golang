# ============================================================================
# Required. The app refuses to start without every variable in this block and
# reports all the missing ones at once.
# ============================================================================

# Application Configuration
PORT=8181
LOG_LEVEL=INFO
# Set to "development", "dev" or "local" to disable response caching for
# slices that opt in. Any other value (or unset) = production (cache on).
APP_ENV=development

# Database Configuration
DB_DRIVER=postgres

# Tenant database. One per deployment — this service no longer routes between
# several tenant databases, so there is exactly one DSN here.
DB_DSN="postgresql://root@192.168.18.2:26257/defaultdb?sslmode=disable"


# Bunny CDN Configuration (if needed)
BUNNY_API_KEY=
BUNNY_BASE_URL=https://video.bunnycdn.com/library/
BUNNY_TIMEOUT_SECONDS=30

# The transcription slice uses BUNNY_API_KEY (account-level) to resolve the
# per-library CDN hostname dynamically:
#   GET https://api.bunny.net/videolibrary/{libId}   -> PullZoneId
#   GET https://api.bunny.net/pullzone/{pullZoneId}  -> Hostnames[].Value
# It then builds the HLS playlist URL as
#   https://{cdnHostname}/{videoGuid}/playlist.m3u8
# Hostnames are cached in-process for the lifetime of the binary.

UPSTASH_REDIS_URL=

# DigitalOcean Spaces. One bucket per deployment: every upload targets
# DO_SPACES_BUCKET. Reads still resolve the bucket from the object URL, so
# media uploaded before this deployment owned its bucket stays readable.
DO_SPACES_ID=
DO_SPACES_SECRET=
DO_SPACES_BUCKET=
DO_SPACES_URL=

# Shared secret for the internal admin endpoints (x-internal-api-key):
# /api/v1/ai/*, /api/v1/sso/generate-token and /api/lessons/*. Required — an
# empty value would make a request without the header compare equal and pass.
INTERNAL_AI_API_KEY=

# The backend's own listening host+port. Used by legacy code paths that
# reference the BACKEND URL (e.g., magic-link endpoints served out of this
# service). Do NOT use this for customer-facing links — that's what
# PUBLIC_DOMAIN_URL is for.
PUBLIC_ROOT_DOMAIN=localhost:8181

# Customer-facing frontend root domain. Used to build:
#   - The `From` address of transactional email (naoresponder@<PUBLIC_DOMAIN_URL>)
#   - The magic-link URL root for tenants with only a subdomain
#     (e.g., tenant "demo" + root "memberclass.com.br" → demo.memberclass.com.br)
# Tenants with `customDomain` set bypass this and use their own domain.
# Must be a bare host — no scheme, no port, no path.
PUBLIC_DOMAIN_URL=memberclass.com.br

# CDN / storage prefix where tenant logos and other relative assets live.
# Used to resolve a relative `logo` column into a full URL inside email
# templates. Example: https://storage.filesmemberclass.com
# Falls back to NEXT_PUBLIC_FILES_URL for shared-.env ergonomics.
PUBLIC_FILES_URL=

# Postgres with the pgvector extension, dedicated to transcription. Create it
# from a pgvector template — the vanilla Postgres image will not do. Its schema
# ships inside the binary and is applied at boot, so a fresh database needs no
# manual setup. Transcription needs this AND OPENAI_API_KEY; with either
# missing the worker stays inert and the rest of the API is unaffected.
DB_TRANSCRIPTION_DSN=

# OpenAI key used by the transcription slice for Whisper + embeddings. If unset,
# the slice logs a warning and refuses to claim transcription jobs at runtime
# (other features keep working).
OPENAI_API_KEY=

# Transcription worker tuning.
#   TRANSCRIPTION_WORKER_CONCURRENCY: goroutines processing jobs in parallel (default 2).
#   TRANSCRIPTION_POLL_INTERVAL_SECONDS: how often the worker polls the jobs table (default 30).
TRANSCRIPTION_WORKER_CONCURRENCY=2
TRANSCRIPTION_POLL_INTERVAL_SECONDS=30

# Panda Video (transcription source, single-tenant rollout)
PANDA_API_KEY=
PANDA_ALLOWED_TENANT_IDS=cmi3afxq70005jl0cwp6gmb8a

# NextAuth shared secret. Verifies both the session cookie (/api/comments) and
# the short-lived HS256 JWTs the frontend mints at /api/auth/go-token
# (/imports/*). MUST match the frontend's NEXTAUTH_SECRET byte-for-byte.
NEXTAUTH_SECRET=

# ============================================================================
# Optional. A missing variable here disables one feature and logs a warning
# naming it at startup; everything else keeps working.
# ============================================================================

# PDF page rendering (/api/lessons/*). Comma-separated; keys are rotated and
# a key that reports exhausted credits is blacklisted for a while.
ILOVEPDF_BASE_URL=https://api.ilovepdf.com/v1
ILOVEPDF_API_KEYS=

# Transactional email for the member-import slice.
RESEND_API_KEY=
RESEND_BASE_URL=

# Push notifications. At least one is needed for the notifications worker to
# dispatch; each is a Firebase service-account JSON for one project.
FIREBASE_SERVICE_ACCOUNT_KEY=
FIREBASE_SERVICE_ACCOUNT_KEY_2=
FIREBASE_SERVICE_ACCOUNT_KEY_3=
FIREBASE_SERVICE_ACCOUNT_KEY_4=
FIREBASE_SERVICE_ACCOUNT_KEY_5=

# Lets the monthly analytics rollup delete the raw rows it has aggregated.
# Off unless set to exactly "true": the deletion is not recoverable.
ANALYTICS_DELETE_ENABLED=false